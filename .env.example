# 서버(Supabase Edge Function)에서만 쓰는 값의 '이름'입니다. 실제 값은 이 파일에 적지 마세요.
# Supabase 화면: Edge Functions > Secrets 에서 같은 이름으로 등록합니다. (브라우저·GitHub에 올리면 안 됩니다)
SERPAPI_API_KEY=
CRON_SECRET=
# 아래 두 개는 Supabase 가 Edge Function 에 자동으로 넣어 줍니다 (직접 만들 필요 없음)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# 매장 찾기 (NAVER API HUB 지역 검색) - Supabase Edge Functions > Secrets 에 등록 (값은 여기에 적지 마세요)
NAVER_APIHUB_CLIENT_ID=
NAVER_APIHUB_CLIENT_SECRET=

# AI 노출 진단 (Gemini) - Supabase Edge Functions > Secrets 에 등록 (값은 여기에 적지 마세요). 자세한 순서: supabase/GEMINI_SETUP.md
GEMINI_API_KEY=
# 선택: GEMINI_MODEL, IP_HASH_SALT, DIAGNOSE_IP_LIMIT(기본 3), DIAGNOSE_DAILY_LIMIT(기본 100)

# 홈페이지 자동 채우기(aeo-prefill): 키는 필요 없어요. 선택: PREFILL_HOURLY_LIMIT(기본 20). 자세한 순서: supabase/PREFILL_SETUP.md
